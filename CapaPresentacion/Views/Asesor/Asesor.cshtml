@{
    ViewBag.Title = "Asesores de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-user-tie"></i> Gestión de Asesores de Venta
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Crear Nuevo Asesor
                </button>
            </div>
        </div>

        <table id="tablaasesores" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>CI</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Asesor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-2">
                    <div class="col-sm-6 mb-3">
                        <label for="txtNombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNombre" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtApellidos" class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="txtApellidos" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtCi" class="form-label">CI</label>
                        <input type="text" class="form-control" id="txtCi" autocomplete="off" maxlength="50">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtTelefono" class="form-label">Teléfono</label>
                        <input type="text" class="form-control" id="txtTelefono" autocomplete="off" maxlength="15">
                    </div>
                    <div class="col-sm-12">
                        <label for="txtDireccion" class="form-label">Dirección</label>
                        <input type="text" class="form-control" id="txtDireccion" autocomplete="off" maxlength="255">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var tabladata;
        var filaSeleccionada;

        document.addEventListener('DOMContentLoaded', function () {
            tabladata = $('#tablaasesores').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarAsesores", "Asesor")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "nombre" },
                    { "data": "apellidos" },
                    { "data": "ci" },
                    { "data": "telefono" },
                    { "data": "direccion" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "125px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            // Evento de clic para el botón Editar de la tabla
            $("#tablaasesores tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            // Evento de clic para el botón Eliminar de la tabla
            $("#tablaasesores tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });
        });

        // Limpia el formulario
        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtNombre").value = "";
            document.getElementById("txtApellidos").value = "";
            document.getElementById("txtTelefono").value = "";
            document.getElementById("txtCi").value = "";
            document.getElementById("txtDireccion").value = "";
        }

        // Abre el modal para crear o editar
        function abrirModal(json) {
            Limpiar();
            if (json != null) {
                document.getElementById("txtid").value = json.id_asesor;
                document.getElementById("txtNombre").value = json.nombre;
                document.getElementById("txtApellidos").value = json.apellidos;
                document.getElementById("txtTelefono").value = json.telefono;
                document.getElementById("txtCi").value = json.ci;
                document.getElementById("txtDireccion").value = json.direccion;
                document.getElementById("modalTitle").textContent = "Editar Asesor";
            } else {
                document.getElementById("modalTitle").textContent = "Crear Nuevo Asesor";
            }
            $('#FormModal').modal('show');
        }

        // Función para guardar un Asesor usando FETCH y SweetAlert2
        async function Guardar() {
            const asesor = {
                id_asesor: parseInt(document.getElementById("txtid").value),
                nombre: document.getElementById("txtNombre").value.trim(),
                apellidos: document.getElementById("txtApellidos").value.trim(),
                telefono: document.getElementById("txtTelefono").value.trim(),
                ci: document.getElementById("txtCi").value.trim(),
                direccion: document.getElementById("txtDireccion").value.trim()
            };

            const esNuevo = asesor.id_asesor === 0;

            // ***** CORRECCIÓN CLAVE: Se elimina la validación genérica de JS *****

            Swal.fire({
                title: esNuevo ? "Registrando asesor..." : "Actualizando asesor...",
                html: "Validando datos...",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarAsesor", "Asesor")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({ objeto: asesor })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado && data.resultado > 0) { // Éxito si resultado > 0 (ID generado) o true (booleano)
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    if (esNuevo) {
                        asesor.id_asesor = data.resultado;
                        tabladata.row.add(asesor).draw(false);
                    } else {
                        // Recargar la fila para asegurar que se vean los cambios
                        tabladata.ajax.reload(null, false);
                    }

                    $('#FormModal').modal("hide");
                } else {
                    // ERROR: Muestra el mensaje ESPECÍFICO devuelto por la Capa de Negocio
                    Swal.fire({
                        title: "¡Error de Validación!",
                        text: data.mensaje, // Este es el mensaje específico de la CN, ej: "El nombre es obligatorio."
                        icon: 'error'
                    });
                }
            } catch (error) {
                Swal.fire({ title: "¡Error!", text: "Ocurrió un error inesperado al guardar.", icon: 'error' });
                console.error(error);
            }
        }

        // Función para eliminar un Asesor (se mantiene sin cambios)
        async function Eliminar(asesor) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará al asesor: ${asesor.nombre} ${asesor.apellidos}. Esto no se podrá revertir.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        text: "Verificando comisiones y eliminando.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarAsesor", "Asesor")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: asesor.id_asesor })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            tabladata.row(filaSeleccionada).remove().draw();
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}
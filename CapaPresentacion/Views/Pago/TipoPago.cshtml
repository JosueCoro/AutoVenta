@{
    ViewBag.Title = "Tipos de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Se incluye SweetAlert2 para notificaciones modernas -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Se incluye Datatables CSS si no está en bundles -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-credit-card"></i> Gestión de Tipos de Pago
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Crear Nuevo Tipo
                </button>
            </div>
        </div>

        <table id="tablatipopago" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal para Crear/Editar Tipo de Pago -->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Tipo de Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-2">
                    <div class="col-sm-12">
                        <label for="txtNombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNombre" autocomplete="off" maxlength="150">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var tabladata;
        var filaSeleccionada;

        document.addEventListener('DOMContentLoaded', function () {
            tabladata = $('#tablatipopago').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarTiposPago", "Pago")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "nombre" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "125px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            $("#tablatipopago tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            $("#tablatipopago tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });
        });

        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtNombre").value = "";
        }

        function abrirModal(json) {
            Limpiar();
            if (json != null) {
                document.getElementById("txtid").value = json.id_tipo_pago;
                document.getElementById("txtNombre").value = json.nombre;
                document.getElementById("modalTitle").textContent = "Editar Tipo de Pago";
            } else {
                document.getElementById("modalTitle").textContent = "Crear Nuevo Tipo de Pago";
            }
            $('#FormModal').modal('show');
        }

        async function Guardar() {
            const tipoPago = {
                id_tipo_pago: parseInt(document.getElementById("txtid").value),
                nombre: document.getElementById("txtNombre").value.trim()
            };

            const esNuevo = tipoPago.id_tipo_pago === 0;

            if (tipoPago.nombre === "") {
                Swal.fire('Advertencia', 'El nombre no puede ser vacío.', 'warning');
                return;
            }

            Swal.fire({
                title: esNuevo ? "Registrando tipo..." : "Actualizando tipo...",
                html: "Por favor, espera...",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarTipoPago", "Pago")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({ objeto: tipoPago })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado) {
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    if (esNuevo) {
                        tipoPago.id_tipo_pago = data.resultado;
                        tabladata.row.add(tipoPago).draw(false);
                    } else {
                        tabladata.row(filaSeleccionada).data(tipoPago).draw(false);
                    }

                    $('#FormModal').modal("hide");
                } else {
                    Swal.fire({ title: "¡Error!", text: data.mensaje, icon: 'error' });
                }
            } catch (error) {
                Swal.fire({ title: "¡Error!", text: "Ocurrió un error inesperado al guardar.", icon: 'error' });
                console.error(error);
            }
        }

        async function Eliminar(tipoPago) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el tipo de pago: ${tipoPago.nombre}. Esto eliminará la categoría.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        text: "Verificando dependencias y eliminando.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarTipoPago", "Pago")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: tipoPago.id_tipo_pago })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            tabladata.row(filaSeleccionada).remove().draw();
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}

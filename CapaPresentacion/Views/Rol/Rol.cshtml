@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<SelectListItem> listaEstados = ViewBag.ListaEstados;
}

<!-- Se incluye SweetAlert2 y Datatables (links omitidos por brevedad) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-users-cog"></i> Gestión de Roles de Usuario
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Crear Nuevo Rol
                </button>
            </div>
        </div>

        <table id="tablaroles" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal para Crear/Editar Rol -->
<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-2">
                    <div class="col-sm-12 mb-3">
                        <label for="txtNombre" class="form-label">Nombre del Rol</label>
                        <input type="text" class="form-control" id="txtNombre" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-12">
                        <label for="cboEstado" class="form-label">Estado</label>
                        <select id="cboEstado" class="form-control">
                            @foreach (var estado in listaEstados)
                            {
                                <option value="@estado.Value">@estado.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var tabladata;
        var filaSeleccionada;

        // Función auxiliar para renderizar el estado como badge
        function renderizarEstado(data) {
            if (data) {
                return '<span class="badge bg-success text-white">Activo</span>';
            } else {
                return '<span class="badge bg-danger text-white">Inactivo</span>';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            tabladata = $('#tablaroles').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarRoles", "Rol")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "nombre" },
                    {
                        "data": "estado",
                        "render": function (data) { return renderizarEstado(data); }
                    },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "125px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            // Evento de clic para el botón Editar de la tabla
            $("#tablaroles tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            // Evento de clic para el botón Eliminar de la tabla
            $("#tablaroles tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });
        });

        // Limpia el formulario
        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtNombre").value = "";
            document.getElementById("cboEstado").value = "1"; // Activo por defecto
        }

        // Abre el modal para crear o editar
        function abrirModal(json) {
            Limpiar();
            if (json != null) {
                document.getElementById("txtid").value = json.id_rol;
                document.getElementById("txtNombre").value = json.nombre;
                // El valor del estado es "1" (Activo) o "0" (Inactivo) en la DB (BIT),
                // pero C# lo convierte a boolean (true/false). Lo convertimos a string para el select.
                document.getElementById("cboEstado").value = json.estado ? "1" : "0";
                document.getElementById("modalTitle").textContent = "Editar Rol";
            } else {
                document.getElementById("modalTitle").textContent = "Crear Nuevo Rol";
            }
            $('#FormModal').modal('show');
        }

        // Función para guardar un Rol usando FETCH y SweetAlert2
        async function Guardar() {
            const rol = {
                id_rol: parseInt(document.getElementById("txtid").value),
                nombre: document.getElementById("txtNombre").value.trim(),
                // Convertir el string "1" o "0" a booleano esperado por C#
                estado: document.getElementById("cboEstado").value === "1"
            };

            const esNuevo = rol.id_rol === 0;

            Swal.fire({
                title: esNuevo ? "Registrando rol..." : "Actualizando rol...",
                html: "Validando datos...",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarRol", "Rol")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({ objeto: rol })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado && data.resultado > 0) { // Éxito
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    // Recargar la tabla
                    tabladata.ajax.reload(null, false);

                    $('#FormModal').modal("hide");
                } else {
                    // ERROR: Muestra el mensaje ESPECÍFICO de la Capa de Negocio
                    Swal.fire({
                        title: "¡Error de Validación!",
                        text: data.mensaje,
                        icon: 'error'
                    });
                }
            } catch (error) {
                Swal.fire({ title: "¡Error!", text: "Ocurrió un error inesperado al guardar.", icon: 'error' });
                console.error(error);
            }
        }

        // Función para eliminar un Rol
        async function Eliminar(rol) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el rol: ${rol.nombre}. Esto no se podrá revertir.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        text: "Verificando usuarios asociados y eliminando.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarRol", "Rol")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: rol.id_rol })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            tabladata.row(filaSeleccionada).remove().draw();
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                        } else {
                            // Maneja el error de dependencia (rol con usuarios)
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}

@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<SelectListItem> listaEstados = ViewBag.ListaEstados;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-users"></i> Gestión de Usuarios del Sistema
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Crear Nuevo Usuario
                </button>
            </div>
        </div>

        <table id="tablausuarios" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>CI</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="txtid" type="hidden" value="0" />
                <div class="row g-3">
                    <div class="col-sm-6 mb-3">
                        <label for="txtNombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNombre" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtApellido" class="form-label">Apellido</label>
                        <input type="text" class="form-control" id="txtApellido" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtCi" class="form-label">CI</label>
                        <input type="text" class="form-control" id="txtCi" autocomplete="off" maxlength="50">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtTelefono" class="form-label">Teléfono</label>
                        <input type="text" class="form-control" id="txtTelefono" autocomplete="off" maxlength="15">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtCorreo" class="form-label">Correo</label>
                        <input type="email" class="form-control" id="txtCorreo" autocomplete="off" maxlength="150">
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="txtContrasena" class="form-label">Contraseña</label>
                        <input type="password" class="form-control" id="txtContrasena" placeholder="Solo si desea cambiarla" autocomplete="off" maxlength="150">
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label for="cboRol" class="form-label">Rol</label>
                        <select id="cboRol" class="form-control">
                            <option value="0">Cargando...</option>
                        </select>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label for="cboEstado" class="form-label">Estado</label>
                        <select id="cboEstado" class="form-control">
                            @foreach (var estado in listaEstados)
                            {
                                <option value="@estado.Value">@estado.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var tabladata;
        var filaSeleccionada;

        function renderizarEstado(data) {
            if (data) {
                return '<span class="badge bg-success text-white">Activo</span>';
            } else {
                return '<span class="badge bg-danger text-white">Inactivo</span>';
            }
        }
        async function llenarRoles() {
            try {
                const response = await fetch('@Url.Action("ListarRoles", "Rol")', { method: 'GET' });
                const data = await response.json();
                const roles = data.data;
                const ddlRol = document.getElementById("cboRol");
                ddlRol.innerHTML = '';
                roles.forEach(rol => {
                    const option = document.createElement('option');
                    option.value = rol.id_rol;
                    option.textContent = rol.nombre;
                    ddlRol.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboRol").innerHTML = '<option value="0">Error al cargar marcas</option>';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            llenarRoles(); 
            tabladata = $('#tablausuarios').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarUsuarios", "Usuario")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "nombre" },
                    { "data": "apellido" },
                    { "data": "ci" },
                    { "data": "correo" },
                    { "data": "telefono" },
                    { "data": "oRol.nombre" },
                    {
                        "data": "estado",
                        "render": function (data) { return renderizarEstado(data); }
                    },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-user-slash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "125px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            $("#tablausuarios tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            $("#tablausuarios tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });
        });

        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtNombre").value = "";
            document.getElementById("txtApellido").value = "";
            document.getElementById("txtCi").value = "";
            document.getElementById("txtTelefono").value = "";
            document.getElementById("txtCorreo").value = "";
            document.getElementById("txtContrasena").value = "";
            document.getElementById("cboRol").value = $('#cboRol option:first').val();
            document.getElementById("cboEstado").value = "1";
        }

        function abrirModal(json) {
            Limpiar();
            if (json != null) {
                document.getElementById("txtid").value = json.id_usuario;
                document.getElementById("txtNombre").value = json.nombre;
                document.getElementById("txtApellido").value = json.apellido;
                document.getElementById("txtCi").value = json.ci;
                document.getElementById("txtTelefono").value = json.telefono;
                document.getElementById("txtCorreo").value = json.correo;
                document.getElementById("txtContrasena").placeholder = "Dejar vacío para no cambiar";

                document.getElementById("cboRol").value = json.oRol.id_rol;
                document.getElementById("cboEstado").value = json.estado ? "1" : "0";

                document.getElementById("modalTitle").textContent = "Editar Usuario";
            } else {
                document.getElementById("txtContrasena").placeholder = "Requerido para nuevo usuario";
                document.getElementById("modalTitle").textContent = "Crear Nuevo Usuario";
            }
            $('#FormModal').modal('show');
        }

        async function Guardar() {
            const esNuevo = parseInt(document.getElementById("txtid").value) === 0;

            const usuario = {
                id_usuario: parseInt(document.getElementById("txtid").value),
                nombre: document.getElementById("txtNombre").value.trim(),
                apellido: document.getElementById("txtApellido").value.trim(),
                ci: document.getElementById("txtCi").value.trim(),
                telefono: document.getElementById("txtTelefono").value.trim(),
                correo: document.getElementById("txtCorreo").value.trim(),
                contraseña: document.getElementById("txtContrasena").value.trim(),
                estado: document.getElementById("cboEstado").value === "1",

                oRol: { id_rol: parseInt(document.getElementById("cboRol").value) || 0 }
            };


            Swal.fire({
                title: esNuevo ? "Registrando usuario..." : "Actualizando usuario...",
                html: "Validando y hasheando contraseña...",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarUsuario", "Usuario")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({ objeto: usuario })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();
                console.log("Valor de data.resultado:", data.resultado);

                if (data.resultado && data.resultado > 0) {
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    if (typeof tabladata !== 'undefined' && tabladata !== null) {
                        tabladata.ajax.reload(null, false);
                    }

                    $('#FormModal').modal("hide");
                } else {
                    Swal.fire({
                        title: "¡Error de Validación!",
                        text: data.mensaje,
                        icon: 'error'
                    });
                }
            } catch (error) {
                Swal.fire({
                    title: "¡Error!",
                    text: error.message || "Ocurrió un error inesperado al guardar.",
                    icon: 'error'
                });
                console.error("Error en GuardarUsuario:", error);
            }

        }


        async function Eliminar(usuario) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se inactivará al usuario: ${usuario.correo}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, Inactivar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Inactivando...",
                        text: "Aplicando borrado lógico.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarUsuario", "Usuario")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: usuario.id_usuario })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            Swal.fire('¡Inactivado!', data.mensaje, 'success');
                            tabladata.ajax.reload(null, false);
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}

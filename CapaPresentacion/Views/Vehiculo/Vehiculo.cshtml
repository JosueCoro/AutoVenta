@{
    ViewBag.Title = "Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<SelectListItem> listaEstados = ViewBag.ListaEstados;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-car"></i> Gestión de Inventario de Vehículos
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Registrar Nuevo Vehículo
                </button>
            </div>
        </div>

        <table id="tablavehiculos" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Modelo</th>
                    <th>Marca</th>
                    <th>Tipo</th>
                    <th>Precio Venta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Detalle de Vehículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formVehiculo">
                    <input id="txtid" type="hidden" value="0" />
                    <input id="txtFechaIngreso" type="hidden" />
                    <input id="txtImagenRuta" type="hidden" value="~/Imagenes/Vehiculos/default.png" />

                    <div class="row g-3">

                        <div class="col-sm-3 text-center">
                            <div class="mb-3">
                                <img id="imgVehiculo" src="@Url.Content("~/imagenes/default.png")" alt="Imagen del Vehículo"
                                     style="max-width: 200px; max-height: 197px; border: 1px solid #ccc; padding: 5px; object-fit: contain;"
                                     class="border rounded mx-auto d-block img-fluid" />
                            </div>
                            <div class="mb-3">
                                <label for="fileImagen" class="form-label d-block">Subir Imagen (JPG/PNG)</label>
                                <input type="file" class="form-control" id="fileImagen" accept="image/png, image/jpeg" />
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label for="txtPlaca" class="form-label">Placa</label>
                                <input type="text" class="form-control" id="txtPlaca" autocomplete="off" maxlength="10">
                            </div>
                            <div class="mb-3">
                                <label for="txtModelo" class="form-label">Modelo</label>
                                <input type="text" class="form-control" id="txtModelo" autocomplete="off" maxlength="20">
                            </div>
                            <div class="mb-3">
                                <label for="txtAnio" class="form-label">Año</label>
                                <input type="text" class="form-control" id="txtAnio" autocomplete="off" maxlength="10">
                            </div>
                            <div class="mb-3">
                                <label for="txtColor" class="form-label">Color</label>
                                <input type="text" class="form-control" id="txtColor" autocomplete="off" maxlength="150">
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label for="cboMarca" class="form-label">Marca</label>
                                <select id="cboMarca" class="form-control">
                                    <option value="0">Cargando...</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="cboTipo" class="form-label">Tipo Vehículo</label>
                                <select id="cboTipo" class="form-control">
                                    <option value="0">Cargando...</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="cboEstado" class="form-label">Estado</label>
                                <select id="cboEstado" class="form-control">
                                    @foreach (var estado in listaEstados)
                                    {
                                        <option value="@estado.Value">@estado.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label for="txtPrecioCompra" class="form-label">Precio Compra (Bs.)</label>
                                <input type="number" step="0.01" class="form-control" id="txtPrecioCompra">
                            </div>
                            <div class="mb-3">
                                <label for="txtPrecioVenta" class="form-label">Precio Venta (Bs.)</label>
                                <input type="number" step="0.01" class="form-control" id="txtPrecioVenta">
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        var tabladata;
        var filaSeleccionada;
        const DEFAULT_IMG_PATH = '@Url.Content("~/imagenes/default.png")'; // Nota: Usar el path real de tu placeholder

        // ===========================================
        // FUNCIONES ASÍNCRONAS PARA CARGAR DROPDOWNS
        // ===========================================
        async function llenarMarcas() {
            try {
                const response = await fetch('@Url.Action("ListarMarcas", "Marca")', { method: 'GET' });
                const data = await response.json();
                const marcas = data.data;
                const ddlMarca = document.getElementById("cboMarca");
                ddlMarca.innerHTML = '';
                marcas.forEach(marca => {
                    const option = document.createElement('option');
                    option.value = marca.id_marca;
                    option.textContent = marca.nombre;
                    ddlMarca.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboMarca").innerHTML = '<option value="0">Error al cargar marcas</option>';
            }
        }

        async function llenarTiposVehiculo() {
            try {
                const response = await fetch('@Url.Action("ListarTiposVehiculo", "Vehiculo")', { method: 'GET' });
                const data = await response.json();
                const tipos = data.data;
                const ddlTipo = document.getElementById("cboTipo");
                ddlTipo.innerHTML = '';
                tipos.forEach(tipo => {
                    const option = document.createElement('option');
                    option.value = tipo.id_tp_vehiculo;
                    option.textContent = tipo.descripcion;
                    ddlTipo.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboTipo").innerHTML = '<option value="0">Error al cargar tipos</option>';
            }
        }


        function mostrarImagen(input) {
             const imgElement = document.getElementById("imgVehiculo");
             if (input.files && input.files[0]) {
                 const reader = new FileReader();
                 reader.onload = function(e) {
                     imgElement.src = e.target.result;
                 };
                 reader.readAsDataURL(input.files[0]);
             }
        }


        document.addEventListener('DOMContentLoaded', function () {
            // Cargar datos maestros al iniciar
            llenarMarcas();
            llenarTiposVehiculo();

            tabladata = $('#tablavehiculos').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarVehiculos", "Vehiculo")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "placa" },
                    { "data": "modelo" },
                    { "data": "oMarca.nombre" },
                    { "data": "oTipoVehiculo.descripcion" },
                    {
                        "data": "precio_venta",
                        "render": function (data) {
                            return '$' + parseFloat(data).toFixed(2);
                        }
                    },
                    { "data": "estado" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "125px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            // Eventos de clic para la tabla
            $("#tablavehiculos tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            $("#tablavehiculos tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });

             // Evento para previsualizar la imagen al seleccionar un archivo
            document.getElementById("fileImagen").addEventListener('change', function(e) {
                 mostrarImagen(this);
            });
            // NOTA: ELIMINAMOS EL BLOQUE DE OCULTAR MENSAJE DE ERROR LOCAL
        });

        // Limpia el formulario
        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtPlaca").value = "";
            document.getElementById("txtModelo").value = "";
            document.getElementById("txtAnio").value = "";
            document.getElementById("txtColor").value = "";
            document.getElementById("txtPrecioCompra").value = "";
            document.getElementById("txtPrecioVenta").value = "";
            document.getElementById("txtFechaIngreso").value = "";

            // Resetear la imagen a default placeholder y la ruta a temporal
            document.getElementById("imgVehiculo").src = DEFAULT_IMG_PATH;
            document.getElementById("txtImagenRuta").value = "~/imagenes/default.png";
            document.getElementById("fileImagen").value = ""; // Limpiar input file

            
            $('#cboEstado').val('En Venta');
        }

        // Abre el modal para crear o editar
        function abrirModal(json) {
            Limpiar();

            if (json != null) {
                document.getElementById("txtid").value = json.id_vehiculo;
                document.getElementById("txtPlaca").value = json.placa;
                document.getElementById("txtModelo").value = json.modelo;
                document.getElementById("txtAnio").value = json.año;
                document.getElementById("txtColor").value = json.color;
                document.getElementById("txtPrecioCompra").value = json.precio_compra;
                document.getElementById("txtPrecioVenta").value = json.precio_venta;
                document.getElementById("txtFechaIngreso").value = json.fecha_ingreso;

                $('#cboMarca').val(json.oMarca.id_marca);
                $('#cboTipo').val(json.oTipoVehiculo.id_tp_vehiculo);
                $('#cboEstado').val(json.estado);

                // Cargar imagen actual y guardar ruta en el hidden field
                if (json.imagen) {
                    const imgPath = json.imagen.startsWith('~/') ? '@Url.Content("~")' + json.imagen.substring(1) : json.imagen;
                    document.getElementById("imgVehiculo").src = imgPath;
                    document.getElementById("txtImagenRuta").value = json.imagen;
                }

                document.getElementById("modalTitle").textContent = "Editar Vehículo";
            } else {
                document.getElementById("modalTitle").textContent = "Registrar Nuevo Vehículo";
            }
            $('#FormModal').modal('show');
        }

        // Función para guardar un Vehículo
        async function Guardar() {
            const esNuevo = parseInt(document.getElementById("txtid").value) === 0;
            const archivoImagen = document.getElementById("fileImagen").files[0];

            const vehiculoData = {
                id_vehiculo: parseInt(document.getElementById("txtid").value),
                placa: document.getElementById("txtPlaca").value.trim(),
                modelo: document.getElementById("txtModelo").value.trim(),
                año: document.getElementById("txtAnio").value.trim(),
                color: document.getElementById("txtColor").value.trim(),
                estado: $('#cboEstado').val(),
                fecha_ingreso: document.getElementById("txtFechaIngreso").value,
                precio_compra: parseFloat(document.getElementById("txtPrecioCompra").value) || 0,
                precio_venta: parseFloat(document.getElementById("txtPrecioVenta").value) || 0,
                imagen: document.getElementById("txtImagenRuta").value,

                oMarca: { id_marca: parseInt($('#cboMarca').val()) || 0 }, // Aseguramos que sea 0 si es NaN
                oTipoVehiculo: { id_tp_vehiculo: parseInt($('#cboTipo').val()) || 0 }
            };

            if (esNuevo && !archivoImagen) {
                 Swal.fire('Advertencia', 'Debe seleccionar una imagen para registrar el vehículo.', 'warning');
                 return;
            }

            const formData = new FormData();

            if (archivoImagen) {
                formData.append("archivoImagen", archivoImagen);
            }

            // Convertir el objeto JS a JSON string y adjuntarlo
            formData.append("objeto", JSON.stringify(vehiculoData));


            Swal.fire({
                title: esNuevo ? "Registrando vehículo..." : "Actualizando vehículo...",
                html: "Por favor, espera.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarVehiculo", "Vehiculo")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado && data.resultado > 0) {
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    tabladata.ajax.reload(null, false);

                    $('#FormModal').modal("hide");
                } else {
                    Swal.fire({
                        title: "¡Error de Validación!",
                        text: data.mensaje,
                        icon: 'error'
                    });
                }
            } catch (error) {
                Swal.fire({ title: "¡Error!", text: "Ocurrió un error inesperado al guardar.", icon: 'error' });
                console.error(error);
            }
        }

        async function Eliminar(vehiculo) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el vehículo Placa: ${vehiculo.placa}. Esto es irreversible.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        text: "Verificando ventas y eliminando.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarVehiculo", "Vehiculo")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: vehiculo.id_vehiculo })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            tabladata.row(filaSeleccionada).remove().draw();
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}
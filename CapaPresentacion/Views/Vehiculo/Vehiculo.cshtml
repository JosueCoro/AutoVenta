@{
    ViewBag.Title = "Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<SelectListItem> listaEstados = ViewBag.ListaEstados;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-car"></i> Gestión de Inventario de Vehículos
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success mb-3" onclick="abrirModal(null)">
                    <i class="fas fa-plus-circle"></i> Registrar Nuevo Vehículo
                </button>
            </div>
        </div>

        <table id="tablavehiculos" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Placa</th>
                    <th>Modelo</th>
                    <th>Marca</th>
                    <th>Tipo</th>
                    <th>Precio Venta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="FormModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalTitle">Detalle de Vehículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formVehiculo">
                    <input id="txtid" type="hidden" value="0" />
                    <input id="txtFechaIngreso" type="hidden" />
                    <input id="txtImagenRuta" type="hidden" value="" />

                    <div class="row g-3">

                        <div class="col-sm-3 text-center">
                            <div class="mb-3">
                                <img id="imgVehiculo" src="@Url.Content("~/Content/imagenes/default.png")" alt="Imagen del Vehículo"
                                     style="max-width: 200px; max-height: 197px; border: 1px solid #ccc; padding: 5px; object-fit: contain;"
                                     class="border rounded mx-auto d-block img-fluid" />
                            </div>
                            <div class="mb-3">
                                <label for="fileImagen" class="form-label d-block">Subir Imagen (JPG/PNG)</label>
                                <input type="file" class="form-control" id="fileImagen" accept="image/png, image/jpeg" />
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label for="txtPlaca" class="form-label">Placa</label>
                                <input type="text" class="form-control" id="txtPlaca" autocomplete="off" maxlength="10">
                            </div>
                            <div class="mb-3">
                                <label for="txtModelo" class="form-label">Modelo</label>
                                <input type="text" class="form-control" id="txtModelo" autocomplete="off" maxlength="20">
                            </div>
                            <div class="mb-3">
                                <label for="txtAnio" class="form-label">Año</label>
                                <input type="text" class="form-control" id="txtAnio" autocomplete="off" maxlength="10">
                            </div>
                            <div class="mb-3">
                                <label for="txtColor" class="form-label">Color</label>
                                <input type="text" class="form-control" id="txtColor" autocomplete="off" maxlength="150">
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label for="cboMarca" class="form-label">Marca</label>
                                <select id="cboMarca" class="form-control">
                                    <option value="0">Cargando...</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="cboTipo" class="form-label">Tipo Vehículo</label>
                                <select id="cboTipo" class="form-control">
                                    <option value="0">Cargando...</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="cboEstado" class="form-label">Estado</label>
                                <select id="cboEstado" class="form-control">
                                    @foreach (var estado in listaEstados)
                                    {
                                        <option value="@estado.Value">@estado.Text</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="card border-info mb-3 shadow-sm">
                                <div class="card-header bg-info text-white p-1 text-center">
                                    <small><i class="fas fa-sync-alt"></i> Conversor de Moneda</small>
                                </div>
                                <div class="card-body p-2">
                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text bg-light fw-bold" style="font-size: 0.7rem;">T.C.</span>
                                        <input type="number" id="txtTipoCambio" class="form-control" value="7.00" step="0.01" oninput="CalcularDesdeDolar()">
                                    </div>

                                    <div class="input-group input-group-sm mb-1">
                                        <span class="input-group-text bg-success text-white" style="width: 35px;">$</span>
                                        <input type="number" id="calcDolar" class="form-control" placeholder="Dólares" oninput="CalcularDesdeDolar()">
                                    </div>

                                    <div class="text-center my-1 text-muted">
                                        <i class="fas fa-arrows-alt-v"></i>
                                    </div>

                                    <div class="input-group input-group-sm mb-2">
                                        <span class="input-group-text bg-primary text-white" style="width: 35px;">Bs</span>
                                        <input type="number" id="calcBs" class="form-control" placeholder="Bolivianos" oninput="CalcularDesdeBs()">
                                    </div>

                                    <div class="d-grid gap-1">
                                        <button type="button" class="btn btn-outline-info btn-sm py-0" onclick="AplicarConversion('compra')" style="font-size: 0.75rem;">
                                            Usar Bs en Compra
                                        </button>
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0" onclick="AplicarConversion('venta')" style="font-size: 0.75rem;">
                                            Usar Bs en Venta
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="txtPrecioCompra" class="form-label text-info fw-bold">Precio Compra (Bs.)</label>
                                <input type="number" step="0.01" class="form-control border-info" id="txtPrecioCompra">
                            </div>
                            <div class="mb-3">
                                <label for="txtPrecioVenta" class="form-label text-primary fw-bold">Precio Venta (Bs.)</label>
                                <input type="number" step="0.01" class="form-control border-primary" id="txtPrecioVenta">
                            </div>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="Guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ReporteModal" tabindex="-1" aria-labelledby="reporteModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="reporteModalTitle"><i class="fas fa-chart-bar"></i> Reporte de Costo: <span id="reportePlaca"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-sm-3 text-center">
                        <img id="imgReporteVehiculo" src="" style="max-width: 150px; border: 1px solid #ccc; object-fit: contain;" class="border rounded img-fluid" />
                        <p class="mt-2 text-primary fw-bold" id="reporteModeloMarca"></p>
                    </div>
                    <div class="col-sm-9">
                        <h4 class="text-info">Resumen Financiero</h4>
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr><th>Precio de Compra:</th><td><span id="resumenPrecioCompra" class="fw-bold text-success"></span></td></tr>
                                <tr><th>Total de Gastos:</th><td><span id="resumenTotalGastos" class="fw-bold text-danger"></span></td></tr>
                                <tr class="bg-light"><th>Costo Total Vehículo:</th><td><span id="resumenCostoTotal" class="fw-bolder text-dark"></span></td></tr>
                                <tr><th>Precio de Venta:</th><td><span id="resumenPrecioVenta" class="fw-bold text-primary"></span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr />

                <h4 class="text-info mt-4">Detalle de Gastos</h4>
                <table id="tablaGastos" class="table table-striped table-bordered w-100">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo Gasto</th>
                            <th>Descripción</th>
                            <th>Monto (Bs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">TOTAL DE GASTOS:</th>
                            <th id="totalGastosFooter"></th>
                        </tr>
                    </tfoot>
                </table>

                <input type="hidden" id="txtIdVehiculoReporte" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" onclick="PDFReporte()">
                    <i class="fas fa-file-pdf"></i> Generar Reporte PDF
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
    <script>
        var tabladata;
        var filaSeleccionada;
        let reporteGlobal = null;

        const DEFAULT_IMG_PATH = '@Url.Content("~/Content/imagenes/default.png")';

        const IMAGE_SERVICE_URL = '@Url.Action("ObtenerImagen", "Vehiculo")';

        let tablaGastos;
        // 1. Cuando el usuario escribe en el campo de Dólares
        function CalcularDesdeDolar() {
            const tc = parseFloat(document.getElementById("txtTipoCambio").value) || 0;
            const usd = parseFloat(document.getElementById("calcDolar").value) || 0;
            const inputBs = document.getElementById("calcBs");

            if (tc > 0 && usd > 0) {
                inputBs.value = (usd * tc).toFixed(2);
            } else {
                inputBs.value = "";
            }
        }

        // 2. Cuando el usuario escribe en el campo de Bolivianos
        function CalcularDesdeBs() {
            const tc = parseFloat(document.getElementById("txtTipoCambio").value) || 0;
            const bs = parseFloat(document.getElementById("calcBs").value) || 0;
            const inputUsd = document.getElementById("calcDolar");

            if (tc > 0 && bs > 0) {
                inputUsd.value = (bs / tc).toFixed(2);
            } else {
                inputUsd.value = "";
            }
        }

        // 3. Para pasar el resultado de Bolivianos a los inputs del formulario
        function AplicarConversion(destino) {
            const montoBs = document.getElementById("calcBs").value;

            if (montoBs === "" || parseFloat(montoBs) <= 0) {
                Swal.fire('Atención', 'No hay un monto válido para aplicar.', 'warning');
                return;
            }

            if (destino === 'compra') {
                document.getElementById("txtPrecioCompra").value = montoBs;
            } else {
                document.getElementById("txtPrecioVenta").value = montoBs;
            }

            // Limpiamos la calculadora para el siguiente uso
            document.getElementById("calcDolar").value = "";
            document.getElementById("calcBs").value = "";
        }

        function abrirModalReporte(idVehiculo, placa) {
            if ($.fn.DataTable.isDataTable('#tablaGastos')) {
                tablaGastos.destroy();
            }

            $('#tablaGastos tbody').empty();
            $('#totalGastosFooter').text('');

            document.getElementById("txtIdVehiculoReporte").value = idVehiculo;
            document.getElementById("reportePlaca").textContent = placa;
            document.getElementById("imgReporteVehiculo").src = DEFAULT_IMG_PATH;
            document.getElementById("reporteModeloMarca").textContent = "";

            $('#ReporteModal').modal('show');
            cargarReporte(idVehiculo);
        }

        function PDFReporte(idVehiculo) {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');
            let y = 10

            doc.setFontSize(18)
            doc.text('REPORTE DE GATOS DE UN VEHICULO', 105, y, { align: 'center' });
            y += 10;
        }

        async function cargarReporte(idVehiculo) {
            Swal.fire({
                title: "Cargando Reporte...",
                html: "Obteniendo datos de costos y gastos.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch(`@Url.Action("ReporteGastoVehiculo", "Vehiculo")?idVehiculo=${idVehiculo}`, { method: 'GET' });
                const data = await response.json();

                Swal.close();

                if (data.resultado) {
                    const reporte = data.data;
                    reporteGlobal = reporte;

                    const resumen = reporte.Resumen;
                    document.getElementById("resumenPrecioCompra").textContent = `Bs. ${parseFloat(resumen.PrecioCompra).toFixed(2)}`;
                    document.getElementById("resumenTotalGastos").textContent = `Bs. ${parseFloat(resumen.TotalGastos).toFixed(2)}`;
                    document.getElementById("resumenCostoTotal").textContent = `Bs. ${parseFloat(resumen.CostoTotal).toFixed(2)}`;
                    document.getElementById("resumenPrecioVenta").textContent = `Bs. ${parseFloat(resumen.PrecioVenta).toFixed(2)}`;

                    const imgPath = IMAGE_SERVICE_URL + '?nombreArchivo=' + reporte.ImagenRuta;
                    document.getElementById("imgReporteVehiculo").src = `${imgPath}&v=${new Date().getTime()}`;
                    document.getElementById("reporteModeloMarca").textContent = `${reporte.Marca} - ${reporte.Modelo}`;

                    tablaGastos = $('#tablaGastos').DataTable({
                        data: reporte.ListaGastos,
                        destroy: true,
                        ordering: false,
                        searching: false,
                        paging: false,
                        columns: [
                            { "data": "fecha" },
                            { "data": "TipoGasto" },
                            { "data": "descripcion" },
                            {
                                "data": "monto",
                                "render": function (data) {
                                    return 'Bs. ' + parseFloat(data).toFixed(2);
                                }
                            }
                        ],
                        "language": {
                            "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                            "emptyTable": "No hay gastos registrados para este vehículo."
                        },
                        "footerCallback": function (row, data, start, end, display) {
                            let total = 0;
                            if (data.length > 0) {
                               total = data.reduce((sum, item) => sum + item.monto, 0);
                            }
                            $(this.api().column(3).footer()).html(`Bs. **${parseFloat(total).toFixed(2)}**`);
                            document.getElementById("totalGastosFooter").textContent = `Bs. ${parseFloat(total).toFixed(2)}`;
                        }
                    });

                } else {
                    Swal.fire('Error', data.mensaje, 'error');
                    $('#ReporteModal').modal('hide');
                }

            } catch (error) {
                Swal.fire('Error', 'Ocurrió un error inesperado al cargar el reporte.', 'error');
                console.error(error);
                $('#ReporteModal').modal('hide');
            }
        }

        function PDFReporte() {
            if (!reporteGlobal) {
                Swal.fire('Error', 'Primero debe cargar el reporte de gastos del vehículo.', 'warning');
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');
            let y = 30; // Posición inicial

            const reporte = reporteGlobal;
            const resumen = reporte.Resumen;
            const fechaactual = new Date().toLocaleDateString();


            doc.setFontSize(18);
            doc.text('REPORTE DE COSTO Y GASTOS DE VEHÍCULO', 105, 15, { align: 'center' });

            doc.setFontSize(12);
            doc.text(`Vehículo: ${reporte.Placa} (${reporte.Marca} ${reporte.Modelo})`, 10, 30);
            doc.text(`Emisión: ${fechaactual}`, 200, 30, { align: 'right' });
            y = 40;


            doc.setFontSize(12);
            doc.text('Resumen Financiero', 10, y);
            y += 5;

            const gananciaTotal = resumen.PrecioVenta - resumen.CostoTotal;

            const resumenBody = [
                ['Precio de Compra:', `Bs. ${parseFloat(resumen.PrecioCompra).toFixed(2)}`, 'Costo Total Vehículo:', `Bs. ${parseFloat(resumen.CostoTotal).toFixed(2)}`],
                ['Total de Gastos:', `Bs. ${parseFloat(resumen.TotalGastos).toFixed(2)}`, 'Precio de Venta:', `Bs. ${parseFloat(resumen.PrecioVenta).toFixed(2)}`],
                [
                    { content: 'GANANCIA TOTAL:', colSpan: 2, styles: { fontStyle: 'bold', fillColor: [240, 255, 160] } },

                    { content: `Bs. ${gananciaTotal.toFixed(2)}`, colSpan: 2, styles: { fontStyle: 'bold', fillColor: [240, 255, 160], halign: 'center' } }
                ]
            ];

            doc.autoTable({
                startY: y,
                body: resumenBody,
                theme: 'plain',
                margin: { left: 10, right: 10 },
                styles: { fontSize: 10, cellPadding: 2 },
                columnStyles: { 1: { fontStyle: 'bold' }, 3: { fontStyle: 'bold', fillColor: [240, 240, 240] } }
            });

            y = doc.autoTable.previous.finalY + 10;


            doc.setFontSize(14);
            doc.text('Detalle de Gastos por Vehículo', 10, y);
            y += 5;

            const tablaGastosHeaders = [['Fecha', 'Tipo Gasto', 'Descripción', 'Monto (Bs.)']];

            const tablaGastosRows = reporte.ListaGastos.map(gasto => [
                gasto.fecha,
                gasto.TipoGasto,
                gasto.descripcion,
                'Bs. ' + parseFloat(gasto.monto).toFixed(2)
            ]);

            const totalGastosBs = `Bs. ${parseFloat(resumen.TotalGastos).toFixed(2)}`;
            tablaGastosRows.push(['', '', { content: 'TOTAL DE GASTOS:', styles: { fontStyle: 'bold', halign: 'right' } }, { content: totalGastosBs, styles: { fontStyle: 'bold', halign: 'right' } }]);


            doc.autoTable({
                head: tablaGastosHeaders,
                body: tablaGastosRows,
                startY: y,
                theme: 'striped',
                styles: { fontSize: 9 },
                headStyles: { fillColor: [41, 128, 185], textColor: 255 },
                columnStyles: { 3: { halign: 'right' } }
            });


            const placaLimpia = reporte.Placa.replace(/[^a-zA-Z0-9]/g, '');
            doc.save(`Reporte_Costo_${placaLimpia}_${fechaactual.replace(/\//g, '-')}.pdf`);

            Swal.fire('¡Éxito!', 'Reporte PDF generado correctamente.', 'success');
        }

        async function llenarMarcas() {
            try {
                const response = await fetch('@Url.Action("ListarMarcas", "Marca")', { method: 'GET' });
                const data = await response.json();
                const marcas = data.data;
                const ddlMarca = document.getElementById("cboMarca");
                ddlMarca.innerHTML = '';
                marcas.forEach(marca => {
                    const option = document.createElement('option');
                    option.value = marca.id_marca;
                    option.textContent = marca.nombre;
                    ddlMarca.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboMarca").innerHTML = '<option value="0">Error al cargar marcas</option>';
            }
        }

        async function llenarTiposVehiculo() {
            try {
                const response = await fetch('@Url.Action("ListarTiposVehiculo", "Vehiculo")', { method: 'GET' });
                const data = await response.json();
                const tipos = data.data;
                const ddlTipo = document.getElementById("cboTipo");
                ddlTipo.innerHTML = '';
                tipos.forEach(tipo => {
                    const option = document.createElement('option');
                    option.value = tipo.id_tp_vehiculo;
                    option.textContent = tipo.descripcion;
                    ddlTipo.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboTipo").innerHTML = '<option value="0">Error al cargar tipos</option>';
            }
        }


        function mostrarImagen(input) {
             const imgElement = document.getElementById("imgVehiculo");
             if (input.files && input.files[0]) {
                 const reader = new FileReader();
                 reader.onload = function(e) {
                     imgElement.src = e.target.result;
                 };
                 reader.readAsDataURL(input.files[0]);
             }
        }


        document.addEventListener('DOMContentLoaded', function () {
            llenarMarcas();
            llenarTiposVehiculo();

            tabladata = $('#tablavehiculos').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarVehiculos", "Vehiculo")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "placa" },
                    { "data": "modelo" },
                    { "data": "oMarca.nombre" },
                    { "data": "oTipoVehiculo.descripcion" },
                    {
                        "data": "precio_venta",
                        "render": function (data) {
                            return 'Bs. ' + parseFloat(data).toFixed(2);
                        }
                    },
                    { "data": "estado" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar me-2"><i class="fas fa-pen"></i></button>' +
                            '<button type="button" class="btn btn-danger btn-sm btn-eliminar"><i class="fas fa-trash"></i></button>' +
                            '<button type="button" class="btn btn-info btn-sm btn-reporte"><i class="fas fa-chart-bar"></i></button>',
                        "orderable": false,
                        "searchable": false,
                        "width": "150px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            $("#tablavehiculos tbody").on("click", '.btn-editar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModal(data);
            });

            $("#tablavehiculos tbody").on("click", '.btn-eliminar', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                Eliminar(data);
            });


            $("#tablavehiculos tbody").on("click", '.btn-reporte', function () {
                filaSeleccionada = $(this).closest("tr");
                var data = tabladata.row(filaSeleccionada).data();
                abrirModalReporte(data.id_vehiculo, data.placa);
            });

            document.getElementById("fileImagen").addEventListener('change', function(e) {
                 mostrarImagen(this);
            });
        });

        function Limpiar() {
            document.getElementById("txtid").value = 0;
            document.getElementById("txtPlaca").value = "";
            document.getElementById("txtModelo").value = "";
            document.getElementById("txtAnio").value = "";
            document.getElementById("txtColor").value = "";
            document.getElementById("txtPrecioCompra").value = "";
            document.getElementById("txtPrecioVenta").value = "";
            document.getElementById("txtFechaIngreso").value = "";
            document.getElementById("calcDolar").value = "";
            document.getElementById("calcBs").value = "";
            document.getElementById("txtTipoCambio").value = "7.00";

            document.getElementById("imgVehiculo").src = DEFAULT_IMG_PATH + "?v=" + new Date().getTime();
            document.getElementById("txtImagenRuta").value = "default.png";
            document.getElementById("fileImagen").value = "";

            $('#cboEstado').val('En Venta');
        }

        function abrirModal(json) {
            Limpiar();

            if (json != null) {
                document.getElementById("txtid").value = json.id_vehiculo;
                document.getElementById("txtPlaca").value = json.placa;
                document.getElementById("txtModelo").value = json.modelo;
                document.getElementById("txtAnio").value = json.año;
                document.getElementById("txtColor").value = json.color;
                document.getElementById("txtPrecioCompra").value = json.precio_compra;
                document.getElementById("txtPrecioVenta").value = json.precio_venta;
                document.getElementById("txtFechaIngreso").value = json.fecha_ingreso;

                $('#cboMarca').val(json.oMarca.id_marca);
                $('#cboTipo').val(json.oTipoVehiculo.id_tp_vehiculo);
                $('#cboEstado').val(json.estado);

                if (json.imagen) {

                    let imgPath = IMAGE_SERVICE_URL + '?nombreArchivo=' + json.imagen;

                    const urlConCacheBuster = `${imgPath}&v=${new Date().getTime()}`;

                    document.getElementById("imgVehiculo").src = urlConCacheBuster;
                    document.getElementById("txtImagenRuta").value = json.imagen;
                }

                document.getElementById("modalTitle").textContent = "Editar Vehículo";
            } else {
                document.getElementById("modalTitle").textContent = "Registrar Nuevo Vehículo";
            }
            $('#FormModal').modal('show');
        }

        async function Guardar() {
            const esNuevo = parseInt(document.getElementById("txtid").value) === 0;
            const archivoImagen = document.getElementById("fileImagen").files[0];

            const vehiculoData = {
                id_vehiculo: parseInt(document.getElementById("txtid").value),
                placa: document.getElementById("txtPlaca").value.trim(),
                modelo: document.getElementById("txtModelo").value.trim(),
                año: document.getElementById("txtAnio").value.trim(),
                color: document.getElementById("txtColor").value.trim(),
                estado: $('#cboEstado').val(),
                fecha_ingreso: document.getElementById("txtFechaIngreso").value,
                precio_compra: parseFloat(document.getElementById("txtPrecioCompra").value) || 0,
                precio_venta: parseFloat(document.getElementById("txtPrecioVenta").value) || 0,
                imagen: document.getElementById("txtImagenRuta").value,

                oMarca: { id_marca: parseInt($('#cboMarca').val()) || 0 },
                oTipoVehiculo: { id_tp_vehiculo: parseInt($('#cboTipo').val()) || 0 }
            };

            if (esNuevo && !archivoImagen) {
                 Swal.fire('Advertencia', 'Debe seleccionar una imagen para registrar el vehículo.', 'warning');
                 return;
            }

            const formData = new FormData();

            if (archivoImagen) {
                 formData.append("archivoImagen", archivoImagen);
            }

            formData.append("objeto", JSON.stringify(vehiculoData));


            Swal.fire({
                title: esNuevo ? "Registrando vehículo..." : "Actualizando vehículo...",
                html: "Por favor, espera.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("GuardarVehiculo", "Vehiculo")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado && data.resultado > 0) {
                    Swal.fire({
                        title: esNuevo ? "¡Registrado!" : "¡Actualizado!",
                        text: data.mensaje,
                        icon: 'success'
                    });

                    tabladata.ajax.reload(null, false);

                    $('#FormModal').modal("hide");
                } else {
                    Swal.fire({
                        title: "¡Error de Validación!",
                        text: data.mensaje,
                        icon: 'error'
                    });
                }
            } catch (error) {
                Swal.fire({ title: "¡Error!", text: "Ocurrió un error inesperado al guardar.", icon: 'error' });
                console.error(error);
            }
        }

        async function Eliminar(vehiculo) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el vehículo Placa: ${vehiculo.placa}. Esto es irreversible.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        text: "Verificando ventas y eliminando.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarVehiculo", "Vehiculo")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: vehiculo.id_vehiculo })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            tabladata.row(filaSeleccionada).remove().draw();
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}
@using CapaEntidad

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Auto Venta Don Coro</title>

    <link href="vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">

    <link href="~/Content/sb-admin-2.min.css" rel="stylesheet">
    @Styles.Render("~/Content/css")

</head>
<body id="page-top">
    @{
        CapaEntidad.Usuario_Activo oUsuario = (CapaEntidad.Usuario_Activo)Session["Usuario"];
        List<CapaEntidad.Permiso> listaPermisos = oUsuario != null ? oUsuario.ListaPermisos : new List<CapaEntidad.Permiso>();

        bool TienePermiso(string nombreAccion)
        {
            return listaPermisos != null && listaPermisos.Any(p => p.accion.ToUpper() == nombreAccion.ToUpper());
        }
    }
    <div id="wrapper">

        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="index.html">

                <div class="sidebar-brand-text mx-3">Auto Venta</div>
            </a>


            <li class="nav-item active">
                <a class="nav-link" href="@Url.Action("Index", "Home")" ">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Inicio</span>
                </a>
            </li>


            @{
                bool tienePermisosComercial =
                    TienePermiso("Gestionar Cliente") ||
                    TienePermiso("Gestionar Asesores") ||
                    TienePermiso("Gestionar Vehiculo") ||
                    TienePermiso("Gestionar Comisiones") ||
                    TienePermiso("Gestionar Pago") ||
                    TienePermiso("Gestionar Venta") ||
                    TienePermiso("Gestionar Gasto");
            }

            @if (tienePermisosComercial)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">
                    Comercial
                </div>
            }



            @if (TienePermiso("Gestionar Cliente"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Cliente", "Cliente")">
                        <i class="fas fa-fw fa-users"></i>
                        <span>Clientes</span>
                    </a>
                </li>
            }

            @if (TienePermiso("Gestionar Asesores"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Asesor", "Asesor")">
                        <i class="fas fa-fw fa-id-badge"></i>
                        <span>Asesores</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Vehiculo"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Vehiculo", "Vehiculo")">
                        <i class="fas fa-fw fa-car"></i>
                        <span>Vehículos</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Generar Comisiones"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Comision", "Comision")">
                        <i class="fas fa-fw fa-money-check-alt"></i>
                        <span>Comision</span>
                    </a>
                </li>
            }

            @if (TienePermiso("Gestionar Pagos"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Pago", "Pago")">
                        <i class="fas fa-fw fa-credit-card"></i>
                        <span>Pago</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Realizar Venta"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Venta", "Venta")">
                        <i class="fas fa-fw fa-tags"></i>
                        <span>Venta</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Gasto"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Gasto", "Gasto")">
                        <i class="fas fa-fw fa-tags"></i>
                        <span>Gastos Vehicular</span>
                    </a>
                </li>
            }

            @if (TienePermiso("Gestionar Gasto"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("GastoVenta", "Gasto")">
                        <i class="fas fa-fw fa-tags"></i>
                        <span>Gastos de Ventas</span>
                    </a>
                </li>
            }



            @{
                // Definimos una variable para saber si el usuario tiene CUALQUIER permiso de administración
                bool tienePermisosMantenedor =
                    TienePermiso("Gestionar Marcas") ||
                    TienePermiso("Gestionar Tipos de Vehiculo") ||
                    TienePermiso("Gestionar Tipos de Pago") ||
                    TienePermiso("Gestionar Tipos de Gasto");
            }

            @if (tienePermisosMantenedor)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">
                    Mantenimiento
                </div>
            }
            @if (TienePermiso("Gestionar Marcas"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Marca", "Marca")">
                        <i class="fas fa-fw fa-copyright"></i>
                        <span>Marcas</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Tipos de Vehiculo"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("TipoVehiculo", "Vehiculo")">
                        <i class="fas fa-fw fa-truck"></i>
                        <span>Tipo de Vehiculo</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Tipos de Pago"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("TipoPago", "Pago")">
                        <i class="fas fa-fw fa-cash-register"></i>
                        <span>Tipo de Pago</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Tipos de Gasto"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("TipoGasto", "Gasto")">
                        <i class="fas fa-fw fa-funnel-dollar"></i>
                        <span>Tipo de Gastos</span>
                    </a>
                </li>
            }
            @{
                // Definimos una variable para saber si el usuario tiene CUALQUIER permiso de administración
                bool tienePermisosAdmin =
                    TienePermiso("Gestionar Usuarios") ||
                    TienePermiso("Gestionar Roles y Permisos") ||
                    TienePermiso("Visualizar Bitacora");
            }

            @if (tienePermisosAdmin)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">
                    Administracion
                </div>
            }

            @if (TienePermiso("Gestionar Usuarios"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Usuario", "Usuario")">
                        <i class="fas fa-fw fa-user"></i>
                        <span>Usuarios</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Gestionar Roles y Permisos"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Rol", "Rol")">
                        <i class="fas fa-fw fa-users-cog"></i>
                        <span>Roles</span>
                    </a>
                </li>
            }

            @if (TienePermiso("Gestionar Roles y Permisos"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Permiso", "Permiso")">
                        <i class="fas fa-fw fa-key"></i>
                        <span>Permisos</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Visualizar Bitacora"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("Bitacora", "Bitacora")">
                        <i class="fas fa-fw fa-clipboard-list"></i>
                        <span>Bitacora</span>
                    </a>
                </li>
            }

            @{
                bool tienePermisosReporte =
                  TienePermiso("Visualizar Reportes") ||
                  TienePermiso("Visualizar Ganancias por Ventas") ||
                  TienePermiso("Visualizar Ganancias por Vehiculo");
            }

            @if (tienePermisosReporte)
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">
                    REPORTES
                </div>
            }

            @if (TienePermiso("Visualizar Reportes"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("ReporteVentas", "Reporte")">
                        <i class="fas fa-fw fa-chart-area"></i>
                        <span>Ventas por Periodo</span>
                    </a>
                </li>
            }

            @if (TienePermiso("Visualizar Ganancias por Ventas"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("RepoeGananciaVenta", "Reporte")">
                        <i class="fas fa-fw fa-dollar-sign"></i>
                        <span>Rentabilidad por Venta</span>
                    </a>
                </li>
            }
            @if (TienePermiso("Visualizar Ganancias por Vehiculo"))
            {
                <li class="nav-item active">
                    <a class="nav-link" href="@Url.Action("RepoeGananciaVehiculo", "Reporte")">
                        <i class="fas fa-fw fa-car"></i>
                        <span>Rentabilidad por Vehículo</span>
                    </a>
                </li>
            }




            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>



                    <!-- Topbar Navbar -->

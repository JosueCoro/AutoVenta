@{
    ViewBag.Title = "Registro de Gastos de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-money-bill-wave"></i> Registro y Control de Gastos de Ventas
    </div>

    <div class="card-body">

        <div class="row mb-4 border p-3 rounded bg-light">
            <h5 class="text-primary">Asociar Gasto a:</h5>
            <div class="col-sm-6">
                <label for="txtVentaSeleccionada" class="form-label">Venta (Trámites)</label>
                <div class="input-group">
                    <input type="hidden" id="txtIdVentaSeleccionada" value="0" />
                    <input type="text" class="form-control" id="txtVentaSeleccionada" placeholder="Seleccione una venta asociada" readonly />
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalBuscarVenta">
                        <i class="fas fa-search"></i> Buscar Venta
                    </button>
                </div>
            </div>
        </div>

        <h5 class="text-primary mt-4">Detalle de Ítems de Gasto</h5>
        <div class="row g-2 mb-3 border p-3 rounded">
            <div class="col-sm-4">
                <label for="txtDescripcionItem" class="form-label">Descripción</label>
                <input type="text" id="txtDescripcionItem" class="form-control" maxlength="250">
            </div>
            <div class="col-sm-3">
                <label for="txtMontoItem" class="form-label">Monto (Bs.)</label>
                <input type="number" id="txtMontoItem" class="form-control" step="0.01" value="0.00">
            </div>
            <div class="col-sm-3">
                <label for="cboTipoGastoItem" class="form-label">Tipo de Gasto</label>
                <select id="cboTipoGastoItem" class="form-control">
                    <option value="0">Cargando...</option>
                </select>
            </div>
            <div class="col-sm-2 d-flex align-items-end">
                <button type="button" class="btn btn-info w-100" onclick="AgregarItemGasto()">
                    <i class="fas fa-cart-plus"></i> Agregar
                </button>
            </div>
        </div>

        <table id="tablaDetalleGastos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Monto (Bs.)</th>
                    <th>Tipo Gasto</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

        <div class="row mt-4">
            <div class="col-12 text-end">
                <h4 id="lblTotalGastos">Total de Gastos: Bs. 0.00</h4>
                <button type="button" class="btn btn-success btn-lg" onclick="FinalizarRegistroGastos()">
                    <i class="fas fa-check-circle"></i> Registrar Gastos
                </button>
            </div>
        </div>

        <hr />

        <h5 class="text-secondary mt-4">Historial de Gastos Registrados</h5>
        <table id="tablagastos" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo Gasto</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th>Venta Asoc.</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

    </div>
</div>
<div class="modal fade" id="modalBuscarVenta" tabindex="-1" aria-labelledby="modalBuscarVentaLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalBuscarVentaLabel">Buscar Venta para Asociación de Gastos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="tablaVentasModal" class="display cell-border w-100" style="width:100%">
                    <thead>
                        <tr>
                            <th>Nº Venta</th>
                            <th>Cliente (CI/NIT)</th>
                            <th>Vehículo(s)</th>
                            <th>Fecha</th>
                            <th>Total (Bs.)</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        var tabladataGastosRegistrados;
        var tabladataVentasModal;
        var carritoGastos = [];


        async function llenarTiposGasto() {
            try {
                const response = await fetch('@Url.Action("ListarTiposGasto", "Gasto")', { method: 'GET' });
                const data = await response.json();

                if (!data || !Array.isArray(data.data)) {
                    throw new Error("Respuesta inválida del servidor para TipoGasto.");
                }

                const tipos = data.data;
                const ddl = document.getElementById("cboTipoGastoItem");
                ddl.innerHTML = '<option value="0">-- Seleccione --</option>';

                tipos.forEach(tipo => {
                    const option = document.createElement('option');
                    option.value = tipo.id_tipo_gasto;
                    option.textContent = tipo.nombre;
                    option.setAttribute('data-nombre', tipo.nombre);
                    ddl.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboTipoGastoItem").innerHTML = '<option value="0">Error de Carga</option>';
            }
        }


        function AgregarItemGasto() {
            const descripcion = document.getElementById("txtDescripcionItem").value.trim();
            const montoStr = document.getElementById("txtMontoItem").value;
            const idTipoGasto = parseInt(document.getElementById("cboTipoGastoItem").value);
            const nombreTipoGasto = document.getElementById("cboTipoGastoItem").options[document.getElementById("cboTipoGastoItem").selectedIndex].text;

            const monto = parseFloat(montoStr);

            if (descripcion === "") {
                Swal.fire('Advertencia', 'Debe ingresar una descripción para el gasto.', 'warning');
                return;
            }
            if (isNaN(monto) || monto <= 0) {
                Swal.fire('Advertencia', 'El monto debe ser un valor numérico positivo.', 'warning');
                return;
            }
            if (idTipoGasto === 0 || nombreTipoGasto.includes("Cargando") || nombreTipoGasto.includes("Error")) {
                Swal.fire('Advertencia', 'Debe seleccionar un Tipo de Gasto válido.', 'warning');
                return;
            }

            const nuevoItem = {
                descripcion: descripcion,
                monto: monto,
                id_tipo_gasto: idTipoGasto,
                nombre_tipo_gasto: nombreTipoGasto
            };

            carritoGastos.push(nuevoItem);
            RenderizarCarrito();
            LimpiarCamposItem();
        }

        function QuitarItemGasto(index) {
            carritoGastos.splice(index, 1);
            RenderizarCarrito();
        }

        function RenderizarCarrito() {
            const tbody = document.querySelector("#tablaDetalleGastos tbody");
            tbody.innerHTML = '';
            let total = 0;

            carritoGastos.forEach((item, index) => {
                total += item.monto;
                const row = tbody.insertRow();

                row.insertCell().textContent = item.descripcion;
                row.insertCell().textContent = item.monto.toFixed(2);
                row.insertCell().textContent = item.nombre_tipo_gasto;

                const cellAccion = row.insertCell();
                const btnQuitar = document.createElement('button');
                btnQuitar.className = 'btn btn-danger btn-sm';
                btnQuitar.innerHTML = '<i class="fas fa-trash"></i>';
                btnQuitar.onclick = () => QuitarItemGasto(index);
                cellAccion.appendChild(btnQuitar);
            });

            document.getElementById("lblTotalGastos").textContent = `Total de Gastos: Bs. ${total.toFixed(2)}`;
        }

        function LimpiarCamposItem() {
            document.getElementById("txtDescripcionItem").value = "";
            document.getElementById("txtMontoItem").value = "0.00";
            document.getElementById("cboTipoGastoItem").value = "0";
        }

        function ResetearFormularioPrincipal() {
            carritoGastos = [];
            RenderizarCarrito();
            document.getElementById("txtIdVentaSeleccionada").value = "0";
            document.getElementById("txtVentaSeleccionada").value = "";
            LimpiarCamposItem();
            tabladataGastosRegistrados.ajax.reload(null, false);
            // Recargar el modal de ventas si está activo
            if (tabladataVentasModal) {
                 tabladataVentasModal.ajax.reload(null, false);
            }
        }

        async function FinalizarRegistroGastos() {
            // Se obtiene del campo oculto, ya no de un cboVenta
            const idVenta = parseInt(document.getElementById("txtIdVentaSeleccionada").value) || 0;

            const idVehiculo = 0;

            if (idVenta === 0) {
                Swal.fire('Error', 'Debe asociar los gastos a una Venta usando el botón "Buscar Venta".', 'error');
                return;
            }
            if (carritoGastos.length === 0) {
                Swal.fire('Error', 'Debe agregar al menos un ítem al detalle de gastos.', 'error');
                return;
            }

            Swal.fire({
                title: "Registrando Gastos...",
                html: "Procesando la transacción.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                // Usar JSON.stringify(carritoGastos) en el body si C# usa JavaScriptSerializer().Deserialize<List<DetalleGasto>>(string)
                const response = await fetch('@Url.Action("RegistrarGastos", "Gasto")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({
                        idVehiculo: idVehiculo,
                        idVenta: idVenta,
                        detalleGastosJson: JSON.stringify(carritoGastos)
                    })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado > 0) {
                    Swal.fire('¡Registrado!', data.mensaje, 'success');
                    ResetearFormularioPrincipal();
                } else {
                    Swal.fire('Error de Registro', data.mensaje, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Ocurrió un error inesperado al registrar.', 'error');
                console.error(error);
            }
        }


        document.addEventListener('DOMContentLoaded', function () {
            llenarTiposGasto();

            // 1. Inicialización de la tabla de Historial de Gastos (abajo)
            tabladataGastosRegistrados = $('#tablagastos').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarGastosVentas", "Gasto")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "fecha" },
                    { "data": "oTipoGasto.nombre" },
                    { "data": "descripcion" },
                    {
                        "data": "monto",
                        "render": function (data) { return `Bs. ${parseFloat(data).toFixed(2)}`; }
                    },
                    {
                        "data": null,
                        "render": function (data) {
                            if (data.id_venta !== null && data.id_venta > 0) {
                                let clienteInfo = "";
                                if (data.oVenta && data.oVenta.oCliente) {
                                    clienteInfo = `${data.oVenta.oCliente.NombreCliente} (${data.oVenta.oCliente.CiNitCliente})`;
                                }
                                return `Venta N° ${data.id_venta} - ${clienteInfo}`;
                            }
                            return 'N/A';
                        }
                    },
                    {
                        "data": "id_gasto",
                        "render": function (data) {
                            return `<button type="button" class="btn btn-danger btn-sm" onclick="EliminarGastoRegistro(${data})"><i class="fas fa-trash"></i></button>`;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "60px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });

            // 2. Inicialización del DataTables del Modal de Ventas (Búsqueda)
            tabladataVentasModal = $('#tablaVentasModal').DataTable({
                responsive: true,
                ordering: true,
                "ajax": {
                    "url": '@Url.Action("ListarVentasSimples", "Gasto")',
                    "type": "GET",
                    "datatype": "json",
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "id_venta" },
                    { "data": "NombreCliente",
                      "render": function (data, type, row) {
                          return `${row.NombreCliente} (${row.CiNitCliente})`;
                      }
                    },
                    { "data": "VehiculosVendidos" },
                    { "data": "fecha" },
                    { "data": "total", "render": function(data) { return `Bs. ${parseFloat(data).toFixed(2)}`; } },
                    {
                        "defaultContent": '<button type="button" class="btn btn-success btn-sm btn-seleccionar-venta"><i class="fas fa-check"></i> Seleccionar</button>',
                        "orderable": false, "searchable": false, "width": "100px"
                    }
                ],
                "language": { "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json' }
            });

            // 3. Evento para SELECCIONAR VENTA del Modal
            $('#tablaVentasModal tbody').on('click', '.btn-seleccionar-venta', function () {
                const dataVenta = tabladataVentasModal.row($(this).parents('tr')).data();

                // Asignar los valores a los campos ocultos y de texto
                document.getElementById('txtIdVentaSeleccionada').value = dataVenta.id_venta;
                document.getElementById('txtVentaSeleccionada').value = `Venta N° ${dataVenta.id_venta} | Cliente: ${dataVenta.NombreCliente} (${dataVenta.CiNitCliente})`;

                // Cerrar el modal
                $('#modalBuscarVenta').modal('hide');
            });

        });

        async function EliminarGastoRegistro(id) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el gasto ID: ${id}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        html: "Revisando y eliminando gasto.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        // Usando JSON.stringify({ id: id }) en el body para el controlador C#
                        const response = await fetch('@Url.Action("EliminarGasto", "Gasto")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: id })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                            tabladataGastosRegistrados.ajax.reload(null, false);
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}
@{
    ViewBag.Title = "Registro de Gastos de Vehiculos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/jquery.dataTables.css" />
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/2.0.8/js/jquery.dataTables.js"></script>


<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-money-bill-wave"></i> Registro y Control de Gastos vehicular
    </div>

    <div class="card-body">

        
        <div class="card-body">

            <div class="row mb-4 border p-3 rounded bg-light">
                <h5 class="text-primary">Asociar Gasto a:</h5>
                <div class="col-sm-6">
                    <label for="txtVehiculoSeleccionado" class="form-label">Vehiculo</label>
                    <div class="input-group">
                        <input type="hidden" id="txtIdVehiculoSeleccionada" value="0" />
                        <input type="text" class="form-control" id="txtVehiculoSeleccionado" placeholder="Seleccione un Vrhiculo" readonly />
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalBuscarVehiculo">
                            <i class="fas fa-search"></i> Buscar Vehiculo
                        </button>
                    </div>
                </div>
            </div>


        </div>

        <h5 class="text-primary mt-4">Detalle del Gasto</h5>
        <div class="row g-2 mb-3 border p-3 rounded">
            <div class="col-sm-3">
                <label for="cboTipoGastoItem" class="form-label">Tipo de Gasto</label>
                <select id="cboTipoGastoItem" class="form-control">
                </select>
            </div>

            <div class="col-sm-3">
                <label for="txtMontoItem" class="form-label">Monto (Bs.)</label>
                <input type="number" id="txtMontoItem" class="form-control" step="0.01" value="0.00">
            </div>
            <div class="col-sm-4">
                <label for="txtDescripcionItem" class="form-label">Descripción</label>
                <input type="text" id="txtDescripcionItem" class="form-control" maxlength="250">
            </div>
            <div class="col-sm-2 d-flex align-items-end">
                <button type="button" class="btn btn-info w-100" onclick="AgregarItemGasto()">
                    <i class="fas fa-cart-plus"></i> Agregar
                </button>
            </div>
        </div>

        <table id="tablaDetalleGastos" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Tipo Gasto</th>
                    <th>Monto (Bs.)</th>
                    <th>Descripción</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

        <div class="row mt-4">
            <div class="col-12 text-end">
                <h4 id="lblTotalGastos">Total de Gastos: Bs. 0.00</h4>
                <button type="button" class="btn btn-success btn-lg" onclick="FinalizarRegistroGastos()">
                    <i class="fas fa-check-circle"></i> Registrar Gastos
                </button>
            </div>
        </div>

        <hr />

        <h5 class="text-secondary mt-4">Historial de Gastos Registrados</h5>
        <table id="tablagastos" class="display cell-border w-100" style="width:100%">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo Gasto</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                    <th>Vehículo Asoc.</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

    </div>
</div>


<div class="modal fade" id="modalBuscarVehiculo" tabindex="-1" aria-labelledby="modalBuscarVehiculoLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalBuscarVehiculoLabel">Buscar Vehiculo para Asociación de Gastos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table id="tablaVehiculosModal" class="display cell-border w-100" style="width:100%">
                    <thead>
                        <tr>
                            <th>ID Vehículo</th>
                            <th>Placa</th>
                            <th>Modelo</th>
                            <th>Color</th>
                            <th>Año</th>
                            <th>Precio Venta (Bs.)</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>



@section Scripts{
    <script>
        var tabladataGastosRegistrados;
        var carritoGastos = [];
        var tablaVehiculosModal;


        async function llenarTiposGasto() {
            try {
                const response = await fetch('@Url.Action("ListarTiposGasto", "Gasto")', { method: 'GET' });
                const data = await response.json();

                if (!data || !Array.isArray(data.data)) {
                    throw new Error("Respuesta inválida del servidor para TipoGasto.");
                }

                const tipos = data.data;
                const ddl = document.getElementById("cboTipoGastoItem");

                tipos.forEach(tipo => {
                    const option = document.createElement('option');
                    option.value = tipo.id_tipo_gasto;
                    option.textContent = tipo.nombre;
                    option.setAttribute('data-nombre', tipo.nombre);
                    ddl.appendChild(option);
                });
            } catch (error) {
                document.getElementById("cboTipoGastoItem").innerHTML = '<option value="0">Error de Carga</option>';
            }
        }


       

       


        function AgregarItemGasto() {
            const descripcion = document.getElementById("txtDescripcionItem").value.trim();
            const montoStr = document.getElementById("txtMontoItem").value;
            const idTipoGasto = parseInt(document.getElementById("cboTipoGastoItem").value);
            const nombreTipoGasto = document.getElementById("cboTipoGastoItem").options[document.getElementById("cboTipoGastoItem").selectedIndex].text;

            const monto = parseFloat(montoStr);

            if (descripcion === "") {
                Swal.fire('Advertencia', 'Debe ingresar una descripción para el gasto.', 'warning');
                return;
            }
            if (isNaN(monto) || monto <= 0) {
                Swal.fire('Advertencia', 'El monto debe ser un valor numérico positivo.', 'warning');
                return;
            }
            if (idTipoGasto === 0 || nombreTipoGasto.includes("Cargando") || nombreTipoGasto.includes("Error")) {
                Swal.fire('Advertencia', 'Debe seleccionar un Tipo de Gasto válido.', 'warning');
                return;
            }

            const nuevoItem = {
                descripcion: descripcion,
                monto: monto,
                id_tipo_gasto: idTipoGasto,
                nombre_tipo_gasto: nombreTipoGasto
            };

            carritoGastos.push(nuevoItem);
            RenderizarCarrito();
            llenarTiposGasto();
            LimpiarCamposItem();
        }

        function QuitarItemGasto(index) {
            carritoGastos.splice(index, 1);
            RenderizarCarrito();
        }

        function RenderizarCarrito() {
            const tbody = document.querySelector("#tablaDetalleGastos tbody");
            tbody.innerHTML = '';
            let total = 0;

            carritoGastos.forEach((item, index) => {
                total += item.monto;
                const row = tbody.insertRow();

                row.insertCell().textContent = item.nombre_tipo_gasto;
                row.insertCell().textContent = item.monto.toFixed(2);
                row.insertCell().textContent = item.descripcion;

                const cellAccion = row.insertCell();
                const btnQuitar = document.createElement('button');
                btnQuitar.className = 'btn btn-danger btn-sm';
                btnQuitar.innerHTML = '<i class="fas fa-trash"></i>';
                btnQuitar.onclick = () => QuitarItemGasto(index);
                cellAccion.appendChild(btnQuitar);
            });

            document.getElementById("lblTotalGastos").textContent = `Total de Gastos: Bs. ${total.toFixed(2)}`;
        }

        function LimpiarCamposItem() {
            document.getElementById("txtDescripcionItem").value = "";
            document.getElementById("txtMontoItem").value = "0.00";
            document.getElementById("cboTipoGastoItem").value = "0";
        }

        function ResetearFormularioPrincipal() {
            carritoGastos = [];
            RenderizarCarrito();
            document.getElementById("txtIdVehiculoSeleccionada").value = "0";
            document.getElementById("txtVehiculoSeleccionado").value = "";
            
            if (tablaVehiculosModal) {
                tablaVehiculosModal.ajax.reload(null, false);
            }
            LimpiarCamposItem();
            llenarTiposGasto();
            tabladataGastosRegistrados.ajax.reload(null, false);
        }


        document.addEventListener("DOMContentLoaded", function () {

            tablaVehiculosModal = $('#tablaVehiculosModal').DataTable({
                responsive: true,
                ordering: true,
                "ajax": {
                    "url": '@Url.Action("ListarVehiculosSimples", "Gasto")',
                    "type": "GET",
                    "datatype": "json",
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "id_vehiculo" },
                    { "data": "placa" },
                    { "data": "modelo" },
                    { "data": "color" },
                    { "data": "año" },
                    { "data": "precio_venta" },
                    {
                        "defaultContent": '<button type="button" class="btn btn-success btn-sm btn-seleccionar-vehiculo"><i class="fas fa-check"></i> Seleccionar</button>',
                        "orderable": false, "searchable": false, "width": "100px"
                    }

                ],
                "language": { "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json' }

            });
            $('#tablaVehiculosModal tbody').on('click', '.btn-seleccionar-vehiculo', function () {
                const dataVehiculo = tablaVehiculosModal.row($(this).parents('tr')).data();

                document.getElementById('txtIdVehiculoSeleccionada').value = dataVehiculo.id_vehiculo;
                document.getElementById('txtVehiculoSeleccionado').value = `Modelo: ${dataVehiculo.modelo} (${dataVehiculo.placa}) | Año: ${dataVehiculo.año} `;

                $('#modalBuscarVehiculo').modal('hide');
            });

        });


        async function FinalizarRegistroGastos() {
            const idVehiculo = parseInt(document.getElementById("txtIdVehiculoSeleccionada").value);

            const idVenta = 0;

            if (idVehiculo === 0) {
                Swal.fire('Error', 'Debe asociar los gastos a un Vehículo, usando el botón "Buscar Vehiculo".', 'error');
                return;
            }
            if (carritoGastos.length === 0) {
                Swal.fire('Error', 'Debe agregar al menos un ítem al detalle de gastos.', 'error');
                return;
            }

            Swal.fire({
                title: "Registrando Gastos...",
                html: "Procesando la transacción.",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('@Url.Action("RegistrarGastos", "Gasto")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify({
                        idVehiculo: idVehiculo,
                        idVenta: idVenta,
                        detalleGastosJson: JSON.stringify(carritoGastos)
                    })
                });

                if (!response.ok) throw new Error("Error en la petición.");

                const data = await response.json();

                if (data.resultado > 0) {
                    Swal.fire('¡Registrado!', data.mensaje, 'success');
                    ResetearFormularioPrincipal();
                } else {
                    Swal.fire('Error de Registro', data.mensaje, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Ocurrió un error inesperado al registrar.', 'error');
                console.error(error);
            }
        }


        document.addEventListener('DOMContentLoaded', function () {
            llenarTiposGasto();

            tabladataGastosRegistrados = $('#tablagastos').DataTable({
                responsive: true,
                ordering: false,
                "ajax": {
                    "url": '@Url.Action("ListarGastos", "Gasto")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "fecha" },
                    { "data": "oTipoGasto.nombre" },
                    { "data": "descripcion" },
                    {
                        "data": "monto",
                        "render": function (data) { return `Bs. ${parseFloat(data).toFixed(2)}`; }
                    },
                    {
                        "data": null,
                        "render": function (data) {
                            if (data.oVehiculo) {
                                return `${data.oVehiculo.modelo} (${data.oVehiculo.año}) (${data.oVehiculo.placa})`;
                            }
                            return '';
                        }
                    },
                    {
                        "data": "id_gasto",
                        "render": function (data) {
                            return `<button type="button" class="btn btn-danger btn-sm" onclick="EliminarGastoRegistro(${data})"><i class="fas fa-trash"></i></button>`;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "60px"
                    }
                ],
                "language": {
                    "url": '//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json',
                },
            });
        });

        async function EliminarGastoRegistro(id) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `Se eliminará el gasto ID: ${id}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: "Eliminando...",
                        html: "Revisando y eliminando gasto.",
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const response = await fetch('@Url.Action("EliminarGasto", "Gasto")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json; charset=utf-8' },
                            body: JSON.stringify({ id: id })
                        });

                        if (!response.ok) throw new Error("Error en la petición.");

                        const data = await response.json();

                        if (data.resultado) {
                            Swal.fire('¡Eliminado!', data.mensaje, 'success');
                            tabladataGastosRegistrados.ajax.reload(null, false);
                        } else {
                            Swal.fire('Error', data.mensaje, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Error', 'Ocurrió un error inesperado al eliminar.', 'error');
                        console.error(error);
                    }
                }
            });
        }
    </script>
}